API_KEY=change-me-in-production
DEVICE=cpu
CUDA_VISIBLE_DEVICES=
VAD_ENGINE=rms
LOG_LEVEL=INFO

# URL accessible depuis le téléphone (IP Wi‑Fi du PC, pas localhost)
# Exemple : http://192.168.1.42:8000
LAN_PUBLIC_URL=


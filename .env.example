# Chemins modèles (relatifs à la racine du projet ou absolus)
PROJECT_ROOT=/app
XLM_ROBERTA_BASE_PATH=/app/NLP/local_models/Roberta_model/models--xlm-roberta-base/snapshots/e73636d4f797dec63c3081bb6ed5c7b0bb3f2089
MULTITASK_WEIGHTS_PATH=/app/NLP/RESULT_multiTask/MultiModel_classifier.pt
MULTITASK_TOKENIZER_PATH=/app/NLP/RESULT_multiTask/tokenizer2_0
DZIRIBERT_PATH=/app/NLP/local_models/dziribert_local

WHISPER_FR_PATH=/app/whisper-finetuned/FR/checkpoint-6250
WHISPER_AR_PATH=/app/whisper-finetuned/AR/checkpoint-2728
WHISPER_DZ_PATH=/app/whisper-finetuned/Darja/checkpoint-1100
STT_USE_FASTER_WHISPER=false
STT_DEFAULT_LANGUAGE=darija
STT_MAX_AUDIO_SEC=12
STT_TORCH_THREADS=4
WS_BUFFER_SECONDS=2.0

# Services (Docker Compose)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
VAD_SERVICE_URL=http://vad:8001
STT_SERVICE_URL=http://stt:8002
NLP_SERVICE_URL=http://nlp:8003
